# نسخة من هذا الملف إلى .env.local (لا تُرفع إلى Git)
# ثم حمّلها: set -a; source .env.local; set +a

# عنوان مشروع Supabase (يبدأ بـ https:// وينتهي بـ .supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# مفتاح العميل (anon/public key) — يُستخدم لمحاكاة المستخدمين المجهولين/المسجّلين
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# مفتاح الخدمة — يُستخدم للحجز/OTP/الإدارة وتنظيف الاختبارات
# يجب أن يكون service-role حقيقيًا (sb_secret_… أو JWT service_role)
# لا تستخدم مفتاحًا يبدأ بـ sb_publishable_ — التطبيق يرفضه.
# تنبيه: هذا المفتاح غير متاح على Lovable Cloud بشكل افتراضي.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# —— إنتاج / تشغيل (اختياري محليًا) ——
# AUTH_OTP_PEPPER=
# WHATSAPP_PROVIDER=twilio
# TWILIO_API_KEY=
# TWILIO_WHATSAPP_FROM=
# HCAPTCHA_SECRET=
# VITE_HCAPTCHA_SITE_KEY=

# —— E2E ——
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_PATIENT_EMAIL=
# E2E_PATIENT_PASSWORD=
